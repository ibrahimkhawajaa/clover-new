# =============================================================================
# Database
# =============================================================================
# Local development only. This file-backed database is not persistent on Vercel.
TURSO_DATABASE_URL=file:./data/clover.db

# Vercel production/preview: set both values in Project Settings > Environment
# Variables. Do not use the local file URL on Vercel.
# TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=your_database_auth_token
#
# For local development against Turso, uncomment the cloud values and run:
# npm run db:setup-turso

# =============================================================================
# Initial admin (hashed on seed — never commit real production secrets)
# =============================================================================
# Used only by the explicit db:setup-turso / db:seed commands.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisToAStrongPassword1!
ADMIN_NAME=Portal Administrator
# ALLOW_WEAK_ADMIN=true

NODE_ENV=development
DEV_RETURN_RESET_TOKEN=true

# =============================================================================
# Password reset email (Resend). Set all three in production.
# =============================================================================
# APP_URL=https://your-domain.example
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Clover Support <support@your-domain.example>
