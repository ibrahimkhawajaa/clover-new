# =============================================================================
# Database
# =============================================================================
# LOCAL DEV (default): data lives in ./data/clover.db — NOT visible in Turso cloud console.
TURSO_DATABASE_URL=file:./data/clover.db

# TURSO CLOUD: create a DB at https://turso.tech then paste URL + token.
# After switching, run: npm run db:push && npm run db:seed
# TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
# TURSO_AUTH_TOKEN=your_turso_token

# =============================================================================
# Initial admin (hashed on seed — never commit real production secrets)
# =============================================================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisToAStrongPassword1!
ADMIN_NAME=Portal Administrator
# ALLOW_WEAK_ADMIN=true

NODE_ENV=development
DEV_RETURN_RESET_TOKEN=true
